{
  "multipart": [
    { "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_core" } },
    { "when": { "north": "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm" } },
    { "when": { "east":  "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm", "y":  90 } },
    { "when": { "south": "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm", "y": 180 } },
    { "when": { "west":  "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm", "y": 270 } },
    { "when": { "up":    "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm", "x": 270 } },
    { "when": { "down":  "true" }, "apply": { "model": "bloodlinesae:block/bloodline_branch_primary_arm", "x":  90 } }
  ]
}
